# Cloudflare Pages · capçaleres del lloc

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # El lloc parla d'un alumne concret. Fora dels cercadors.
  # Treu aquesta línia i robots.txt si algun dia es vol públic.
  X-Robots-Tag: noindex, nofollow

# Els fulls d'estil, els scripts i les dades es tornen a validar a cada visita (una resposta 304,
# gairebé gratis): així un canvi de disseny es veu en recarregar, sense esperar l'hora de memòria
# (5/11/2026: no es veia). La closca comuna (comu/) i cada curs. Les targetes canvien poc i es
# queden una hora. Un curs nou hi afegeix les seves quatre línies (comu/docs/SITE-MAP.md).
/comu/css/*
  Cache-Control: no-cache
/comu/js/*
  Cache-Control: no-cache
/4eso/css/*
  Cache-Control: no-cache
/4eso/js/*
  Cache-Control: no-cache
/4eso/dades/*
  Cache-Control: no-cache
/4eso/targetes/*
  Cache-Control: public, max-age=3600
/1eso/css/*
  Cache-Control: no-cache
/1eso/js/*
  Cache-Control: no-cache
/1eso/dades/*
  Cache-Control: no-cache
/1eso/targetes/*
  Cache-Control: public, max-age=3600
